# Αντίγραψέ το ως .env δίπλα στο docker-compose.prod.yml και συμπλήρωσε.
# ΜΗΝ το κάνεις commit με πραγματικές τιμές.

DSPACE_HOSTNAME=gnosis2.lib.ucy.ac.cy
DSPACE_NAME=Gnosis Institutional Repository

# Images (δες security-hardening/README.md για το build)
DSPACE_IMAGE=dspace-cris:hardened
DSPACE_UI_IMAGE=dspace-cris-angular:local

# Βάλε κάτι τυχαίο. Το upstream compose έχει literal 'dspace'.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

DOCKER_OWNER=dspace
DSPACE_VER=dspace-7_x
SOLR_VER=8.11
